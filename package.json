{
	"name": "chart-generator",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build:embeds": "node scripts/build-embeds.js",
		"build:webflow": "vite build --config vite.webflow.config.js",
		"build:site": "vite build",
		"build": "npm run build:embeds && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"build:stat1": "KF_STAT=1 vite build --config vite.embed.config.js",
		"build:stat2": "KF_STAT=2 vite build --config vite.embed.config.js",
		"build:stat3": "KF_STAT=3 vite build --config vite.embed.config.js",
		"build:stat4": "KF_STAT=4 vite build --config vite.embed.config.js",
		"build:stat5": "KF_STAT=5 vite build --config vite.embed.config.js",
		"build:stat6": "KF_STAT=6 vite build --config vite.embed.config.js",
		"build:statmotivation": "KF_STAT=motivation vite build --config vite.embed.config.js",
		"build:charts": "rm -rf dist-embeds && npm run build:stat1 && npm run build:stat2 && npm run build:stat3 && npm run build:stat4 && npm run build:stat5 && npm run build:stat6 && npm run build:statmotivation"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-netlify": "^6.0.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^22",
		"esbuild": "^0.28.1",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vite-plugin-css-injected-by-js": "^5.0.2"
	},
	"dependencies": {
		"d3": "^7.9.0",
		"gsap": "^3.15.0"
	}
}
